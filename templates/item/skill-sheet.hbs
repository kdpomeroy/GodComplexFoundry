<form class="{{cssClass}} godcomplex sheet item skill" autocomplete="off">
  <header class="sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="item-name">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'SkillName'}}" />
      </h1>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "Description"}}</a>
    <a class="item" data-tab="details">{{localize "Details"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab description" data-group="primary" data-tab="description">
      {{editor description target="system.description" button=true owner=owner editable=editable}}
    </div>

    <div class="tab details" data-group="primary" data-tab="details">
      <div class="form-group">
        <label>{{localize "Attribute"}}</label>
        <select name="system.attribute">
          {{#select system.attribute}}
          {{#each attributeOptions as |label key|}}
          <option value="{{key}}">{{localize label}}</option>
          {{/each}}
          {{/select}}
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "Bonus"}}</label>
        <input type="number" name="system.bonus" value="{{system.bonus}}" />
      </div>

      <div class="form-group">
        <label>{{localize "Specialty"}}</label>
        <input type="text" name="system.specialty" value="{{system.specialty}}" />
      </div>
    </div>
  </section>
</form>
