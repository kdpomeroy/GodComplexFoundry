<form class="{{cssClass}} godcomplex sheet item power" autocomplete="off">
  <header class="sheet-header">
    <img class="item-img" src="{{item.img}}" data-edit="img" title="{{item.name}}" />
    <div class="header-fields">
      <h1 class="item-name">
        <input name="name" type="text" value="{{item.name}}" placeholder="{{localize 'PowerName'}}" />
      </h1>
    </div>
  </header>

  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="description">{{localize "Description"}}</a>
    <a class="item" data-tab="details">{{localize "Details"}}</a>
    <a class="item" data-tab="raises">{{localize "Raises"}}</a>
  </nav>

  <section class="sheet-body">
    <div class="tab description" data-group="primary" data-tab="description">
      {{editor description target="system.description" button=true owner=owner editable=editable}}
    </div>

    <div class="tab details" data-group="primary" data-tab="details">
      <div class="form-group">
        <label>{{localize "Attribute"}}</label>
        <select name="system.attribute">
          {{#select system.attribute}}
          {{#each attributeOptions as |label key|}}
          <option value="{{key}}">{{localize label}}</option>
          {{/each}}
          {{/select}}
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "APCost"}}</label>
        <input type="number" name="system.apCost" value="{{system.apCost}}" min="0" />
      </div>

      <div class="form-group">
        <label>{{localize "GlorieaCost"}}</label>
        <input type="number" name="system.glorieaCost" value="{{system.glorieaCost}}" min="0" />
      </div>

      <div class="form-group">
        <label>{{localize "Range"}}</label>
        <select name="system.range">
          {{#select system.range}}
          {{#each rangeOptions as |label key|}}
          <option value="{{key}}">{{localize label}}</option>
          {{/each}}
          {{/select}}
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "Target"}}</label>
        <input type="text" name="system.target" value="{{system.target}}" />
      </div>
    </div>

    <div class="tab raises" data-group="primary" data-tab="raises">
      <div class="raises-header">
        <h3>{{localize "RaiseEffects"}}</h3>
        <button type="button" class="raise-add">
          <i class="fas fa-plus"></i> {{localize "AddRaise"}}
        </button>
      </div>
      <ol class="raises-list">
        {{#each system.raises as |raise index|}}
        <li class="raise" data-index="{{index}}">
          <div class="raise-fields">
            <div class="form-group">
              <label>{{localize "RaiseLevel"}}</label>
              <input type="number" class="raise-edit" data-field="level" data-index="{{index}}" value="{{raise.level}}" min="1" />
            </div>
            <div class="form-group">
              <label>{{localize "Effect"}}</label>
              <input type="text" class="raise-edit" data-field="effect" data-index="{{index}}" value="{{raise.effect}}" />
            </div>
            <div class="form-group">
              <label>{{localize "Cost"}}</label>
              <input type="number" class="raise-edit" data-field="cost" data-index="{{index}}" value="{{raise.cost}}" min="0" />
            </div>
          </div>
          <div class="raise-controls">
            <a class="raise-delete" data-index="{{index}}"><i class="fas fa-trash"></i></a>
          </div>
        </li>
        {{/each}}
      </ol>
    </div>
  </section>
</form>
