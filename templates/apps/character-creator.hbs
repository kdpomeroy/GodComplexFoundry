<form class="godcomplex character-creator" autocomplete="off">
  <div class="creator-header">
    <h2>Character Creator</h2>
    <div class="step-indicator">
      Step {{add step 1}} of {{totalSteps}}
    </div>
  </div>

  <div class="creator-content">
    {{!-- Step 1: Basic Info --}}
    {{#if (eq stepName "basic-info")}}
    <div class="creator-step">
      <h3>Basic Information</h3>
      
      <div class="form-group">
        <label>Character Name</label>
        <input type="text" class="creator-input" data-field="name" value="{{character.name}}" placeholder="Enter character name" />
      </div>

      <div class="form-group">
        <label>Concept</label>
        <input type="text" class="creator-input" data-field="system.concept" value="{{character.system.concept}}" placeholder="e.g., Fire-wielding detective" />
      </div>

      <div class="form-group">
        <label>Player</label>
        <input type="text" class="creator-input" data-field="system.player" value="{{character.system.player}}" />
      </div>

      <div class="form-group">
        <label>Portrait</label>
        <div class="portrait-container">
          <img src="{{character.img}}" alt="Character portrait" />
          <button type="button" class="portrait-upload">
            <i class="fas fa-upload"></i> Upload Portrait
          </button>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- Step 2: Background --}}
    {{#if (eq stepName "background")}}
    <div class="creator-step">
      <h3>Background</h3>
      <p class="step-description">Choose a background for your character. Each background provides an attribute bonus, a free specialty, a free proficiency, and additional choices.</p>

      {{#if selectedBackground}}
      <div class="selected-background">
        <h4>{{selectedBackground.name}}</h4>
        <p class="bg-attribute"><strong>Attribute Bonus:</strong> +1 {{selectedBackground.attribute_bonus}}</p>
        <p class="bg-free"><strong>Free Specialty:</strong> {{selectedBackground.free_specialty}}</p>
        <p class="bg-free"><strong>Free Proficiency:</strong> {{selectedBackground.free_proficiency}}</p>
        <p class="bg-feature"><strong>Feature:</strong> {{selectedBackground.feature}}</p>
        <p class="bg-ability"><strong>Ability:</strong> {{selectedBackground.ability}}</p>
        <p class="bg-allies"><strong>Allies:</strong> {{selectedBackground.allies}}</p>
        <p class="bg-rivals"><strong>Rivals:</strong> {{selectedBackground.rivals}}</p>
        <p class="bg-wealth"><strong>Wealth Level:</strong> {{selectedBackground.wealth_level}}</p>
      </div>

      {{!-- Specialty Selection --}}
      <div class="selection-section">
        <h4>Specialties ({{selectedSpecialties.length}}/{{selectedBackground.num_specialties}} selected)</h4>
        <div class="choices-grid">
          {{#each selectedBackground.specialty_choices as |specialty|}}
          <button type="button" class="specialty-choice {{#if (includes specialty ../selectedSpecialties)}}selected{{/if}}" data-specialty="{{specialty}}">
            {{specialty}}
          </button>
          {{/each}}
        </div>
      </div>

      {{!-- Proficiency Selection --}}
      <div class="selection-section">
        <h4>Proficiencies ({{selectedProficiencies.length}}/{{selectedBackground.num_proficiencies}} selected)</h4>
        <div class="choices-grid">
          {{#each selectedBackground.proficiency_choices as |proficiency|}}
          <button type="button" class="proficiency-choice {{#if (includes proficiency ../selectedProficiencies)}}selected{{/if}}" data-proficiency="{{proficiency}}">
            {{proficiency}}
          </button>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="backgrounds-grid">
        {{#each backgrounds as |bg|}}
        <div class="background-option {{#if (eq bg.id ../character.system.background)}}selected{{/if}}" data-background="{{bg.id}}">
          <h4>{{bg.name}}</h4>
          <p class="bg-attr-bonus">+1 {{bg.attribute_bonus}}</p>
          <p class="bg-free-spec">Free: {{bg.free_specialty}}</p>
          <p class="bg-free-prof">Free: {{bg.free_proficiency}}</p>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- Step 3: Core Stats --}}
    {{#if (eq stepName "core-stats")}}
    <div class="creator-step">
      <h3>Core Statistics</h3>
      <p class="step-description">Set your character's core stats. These determine your power level and resources.</p>

      <div class="stats-grid">
        <div class="stat-block">
          <label>Tier</label>
          <input type="number" class="creator-input" data-field="system.core.tier.value" value="{{character.system.core.tier.value}}" min="1" max="5" />
          <span class="stat-hint">Power level (1-5)</span>
        </div>

        <div class="stat-block">
          <label>Generation</label>
          <input type="number" class="creator-input" data-field="system.core.generation.value" value="{{character.system.core.generation.value}}" min="1" max="5" />
          <span class="stat-hint">Elysian age (1-5)</span>
        </div>

        <div class="stat-block">
          <label>Domain</label>
          <input type="number" class="creator-input" data-field="system.core.domain.value" value="{{character.system.core.domain.value}}" min="1" max="5" />
          <span class="stat-hint">Territory control (1-5)</span>
        </div>

        <div class="stat-block">
          <label>Size</label>
          <input type="number" class="creator-input" data-field="system.core.size.value" value="{{character.system.core.size.value}}" min="-2" max="2" />
          <span class="stat-hint">Physical size modifier (-2 to +2)</span>
        </div>

        <div class="stat-block">
          <label>XP</label>
          <input type="number" class="creator-input" data-field="system.core.xp.value" value="{{character.system.core.xp.value}}" min="0" />
          <span class="stat-hint">Starting experience points</span>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- Step 4: Attributes --}}
    {{#if (eq stepName "attributes")}}
    <div class="creator-step">
      <h3>Attributes</h3>
      <p class="step-description">Distribute 6 points among your attributes. Each starts at 1, maximum is 5. Your background has already provided +1 to one attribute.</p>
      
      <div class="attribute-points">
        <span class="points-label">Points Remaining:</span>
        <span class="points-value {{#if (eq attributePoints 0)}}complete{{else}}incomplete{{/if}}">{{attributePoints}}</span>
      </div>

      <div class="attributes-grid">
        {{#each character.system.attributes as |attr key|}}
        <div class="attribute-block">
          <label>{{key}}</label>
          <div class="attribute-controls">
            <button type="button" class="attribute-decrease" data-attribute="{{key}}" {{#if (lte attr.value 1)}}disabled{{/if}}>
              <i class="fas fa-minus"></i>
            </button>
            <span class="attribute-value">{{attr.value}}</span>
            <button type="button" class="attribute-increase" data-attribute="{{key}}" {{#if (gte attr.value 5)}}disabled{{/if}}>
              <i class="fas fa-plus"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- Step 5: Skills --}}
    {{#if (eq stepName "skills")}}
    <div class="creator-step">
      <h3>Skills</h3>
      <p class="step-description">Your background has granted you specialties and proficiencies. You can add additional custom skills below.</p>

      {{#if selectedSpecialties.length}}
      <div class="selection-section">
        <h4>Your Specialties</h4>
        <div class="tag-list">
          {{#each selectedSpecialties as |specialty|}}
          <span class="tag">{{specialty}}</span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if selectedProficiencies.length}}
      <div class="selection-section">
        <h4>Your Proficiencies</h4>
        <div class="tag-list">
          {{#each selectedProficiencies as |proficiency|}}
          <span class="tag">{{proficiency}}</span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="selection-section">
        <h4>Additional Custom Skills</h4>
        <div class="skills-list">
          {{#each skillsList as |skill index|}}
          <div class="skill-entry">
            <div class="skill-fields">
              <input type="text" class="creator-input" data-field="skills.{{index}}.name" value="{{skill.name}}" placeholder="Skill name" />
              <select class="creator-input" data-field="skills.{{index}}.attribute">
                {{#select skill.attribute}}
                <option value="strength">Strength</option>
                <option value="dexterity">Dexterity</option>
                <option value="awareness">Awareness</option>
                <option value="composure">Composure</option>
                <option value="presence">Presence</option>
                <option value="intelligence">Intelligence</option>
                {{/select}}
              </select>
              <input type="number" class="creator-input" data-field="skills.{{index}}.bonus" value="{{skill.bonus}}" placeholder="Bonus" />
            </div>
            <button type="button" class="remove-skill" data-index="{{index}}">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{/each}}
        </div>

        <button type="button" class="add-skill">
          <i class="fas fa-plus"></i> Add Custom Skill
        </button>
      </div>
    </div>
    {{/if}}

    {{!-- Step 6: Powers --}}
    {{#if (eq stepName "powers")}}
    <div class="creator-step">
      <h3>Powers</h3>
      <p class="step-description">Select powers from the catalog. Available powers are based on your Tier ({{character.system.core.tier.value}}).</p>

      {{#if powersList.length}}
      <div class="selection-section">
        <h4>Selected Powers ({{powersList.length}})</h4>
        <div class="selected-items-list">
          {{#each powersList as |power index|}}
          <div class="selected-item-entry">
            <div class="selected-item-info">
              <strong>{{power.name}}</strong>
              <span class="item-meta">{{power.system.apCost}} AP | {{power.system.glorieaCost}} Gloriae | {{power.system.range}}</span>
            </div>
            <button type="button" class="remove-power" data-index="{{index}}">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="selection-section">
        <h4>Power Catalog</h4>
        {{#if powersetNames.length}}
        <div class="catalog-tabs">
          {{#each powersetNames as |name index|}}
          <button type="button" class="powerset-tab {{#if (eq index 0)}}active{{/if}}" data-tab="{{name}}">
            {{name}}
          </button>
          {{/each}}
        </div>
        
        <div class="catalog-panels">
          {{#each powersetNames as |name index|}}
          <div class="powerset-catalog-panel catalog-panel {{#if (eq index 0)}}active{{/if}}" data-tab="{{name}}">
            {{#each (lookup ../powersByPowerset name) as |power|}}
            <div class="power-catalog-item {{#if (includes power.name (map ../powersList "name"))}}already-selected{{/if}}" data-power="{{power.name}}">
              <div class="catalog-item-header">
                <strong>{{power.name}}</strong>
                <span class="catalog-item-tier">Tier {{power.flags.tier}}</span>
              </div>
              <div class="catalog-item-meta">
                {{power.system.apCost}} AP | {{power.system.glorieaCost}} Gloriae | {{power.system.range}} | {{power.flags.duration}}
              </div>
              <div class="catalog-item-desc">{{power.system.description}}</div>
            </div>
            {{/each}}
          </div>
          {{/each}}
        </div>
        {{else}}
        <p class="no-data">No powers available at your current Tier. Increase your Tier to unlock more powers.</p>
        {{/if}}
      </div>
    </div>
    {{/if}}

    {{!-- Step 7: Equipment --}}
    {{#if (eq stepName "equipment")}}
    <div class="creator-step">
      <h3>Equipment</h3>
      <p class="step-description">Select equipment from the catalog based on your background's wealth level ({{selectedBackground.wealth_level}}).</p>

      {{#if equipmentList.length}}
      <div class="selection-section">
        <h4>Selected Equipment ({{equipmentList.length}})</h4>
        <div class="selected-items-list">
          {{#each equipmentList as |item index|}}
          <div class="selected-item-entry">
            <div class="selected-item-info">
              <strong>{{item.name}}</strong>
              <span class="item-meta">{{item.system.equipmentType}}{{#if item.system.armor}} | Armor: +{{item.system.armor}}{{/if}}{{#if item.system.damage}} | Damage: {{item.system.damage}}{{/if}}</span>
            </div>
            <button type="button" class="remove-equipment" data-index="{{index}}">
              <i class="fas fa-trash"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/if}}

      <div class="selection-section">
        <h4>Equipment Catalog</h4>
        <div class="catalog-tabs">
          <button type="button" class="equip-tab active" data-tab="armor">Armor</button>
          <button type="button" class="equip-tab" data-tab="weapon">Weapons</button>
          <button type="button" class="equip-tab" data-tab="gear">Gear</button>
        </div>
        
        <div class="catalog-panels">
          {{#each equipmentByType as |items type|}}
          <div class="equipment-catalog-panel catalog-panel {{#if (eq type "armor")}}active{{/if}}" data-tab="{{type}}">
            {{#each items as |item|}}
            <div class="equipment-catalog-item {{#if (includes item.name (map ../equipmentList "name"))}}already-selected{{/if}}" data-item="{{item.name}}">
              <div class="catalog-item-header">
                <strong>{{item.name}}</strong>
                {{#if item.flags.armor_type}}<span class="catalog-item-type">{{item.flags.armor_type}}</span>{{/if}}
                {{#if item.flags.weapon_tag}}<span class="catalog-item-type">{{item.flags.weapon_tag}}</span>{{/if}}
              </div>
              <div class="catalog-item-meta">
                {{#if item.system.armor}}Armor: +{{item.system.armor}}{{/if}}
                {{#if item.system.damage}}Damage: {{item.system.damage}}{{/if}}
                {{#if item.system.bonus}}Bonus: +{{item.system.bonus}}{{/if}}
                {{#if item.flags.weapon_range}} | Range: {{item.flags.weapon_range}}{{/if}}
                {{#if item.flags.item_value}} | Value: {{item.flags.item_value}}{{/if}}
              </div>
              {{#if item.system.description}}<div class="catalog-item-desc">{{item.system.description}}</div>{{/if}}
            </div>
            {{/each}}
          </div>
          {{/each}}
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- Step 8: Review --}}
    {{#if (eq stepName "review")}}
    <div class="creator-step">
      <h3>Review Character</h3>
      <p class="step-description">Review your character before creating it. You can go back to make changes.</p>

      <div class="review-section">
        <h4>Basic Information</h4>
        <div class="review-item">
          <span class="review-label">Name:</span>
          <span class="review-value">{{character.name}}</span>
        </div>
        <div class="review-item">
          <span class="review-label">Concept:</span>
          <span class="review-value">{{character.system.concept}}</span>
        </div>
        {{#if selectedBackground}}
        <div class="review-item">
          <span class="review-label">Background:</span>
          <span class="review-value">{{selectedBackground.name}}</span>
        </div>
        {{/if}}
      </div>

      <div class="review-section">
        <h4>Core Statistics</h4>
        <div class="review-grid">
          <div class="review-item">
            <span class="review-label">Tier:</span>
            <span class="review-value">{{character.system.core.tier.value}}</span>
          </div>
          <div class="review-item">
            <span class="review-label">Generation:</span>
            <span class="review-value">{{character.system.core.generation.value}}</span>
          </div>
          <div class="review-item">
            <span class="review-label">Domain:</span>
            <span class="review-value">{{character.system.core.domain.value}}</span>
          </div>
          <div class="review-item">
            <span class="review-label">Size:</span>
            <span class="review-value">{{character.system.core.size.value}}</span>
          </div>
        </div>
      </div>

      <div class="review-section">
        <h4>Attributes</h4>
        <div class="review-grid">
          {{#each character.system.attributes as |attr key|}}
          <div class="review-item">
            <span class="review-label">{{key}}:</span>
            <span class="review-value">{{attr.value}}</span>
          </div>
          {{/each}}
        </div>
      </div>

      {{#if selectedSpecialties.length}}
      <div class="review-section">
        <h4>Specialties ({{selectedSpecialties.length}})</h4>
        <div class="tag-list">
          {{#each selectedSpecialties as |specialty|}}
          <span class="tag">{{specialty}}</span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if selectedProficiencies.length}}
      <div class="review-section">
        <h4>Proficiencies ({{selectedProficiencies.length}})</h4>
        <div class="tag-list">
          {{#each selectedProficiencies as |proficiency|}}
          <span class="tag">{{proficiency}}</span>
          {{/each}}
        </div>
      </div>
      {{/if}}

      {{#if powersList.length}}
      <div class="review-section">
        <h4>Powers ({{powersList.length}})</h4>
        <ul class="review-list">
          {{#each powersList as |power|}}
          <li><strong>{{power.name}}</strong> ({{power.system.apCost}} AP, {{power.system.glorieaCost}} Gloriae)</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      {{#if equipmentList.length}}
      <div class="review-section">
        <h4>Equipment ({{equipmentList.length}})</h4>
        <ul class="review-list">
          {{#each equipmentList as |item|}}
          <li>{{item.name}} ({{item.system.equipmentType}})</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>

  <div class="creator-footer">
    <button type="button" class="creator-cancel">
      <i class="fas fa-times"></i> Cancel
    </button>
    <div class="creator-navigation">
      {{#unless isFirstStep}}
      <button type="button" class="creator-prev">
        <i class="fas fa-arrow-left"></i> Previous
      </button>
      {{/unless}}
      
      {{#if isLastStep}}
      <button type="button" class="creator-finish">
        <i class="fas fa-check"></i> Create Character
      </button>
      {{else}}
      <button type="button" class="creator-next">
        Next <i class="fas fa-arrow-right"></i>
      </button>
      {{/if}}
    </div>
  </div>
</form>
