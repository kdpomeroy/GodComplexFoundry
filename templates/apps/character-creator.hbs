<form class="godcomplex character-creator" autocomplete="off">
  <div class="creator-header">
    <h2>Character Creator</h2>
    <div class="step-indicator">
      Step {{add step 1}} of {{totalSteps}}
    </div>
  </div>

  <div class="creator-content">
    {{!-- Step 1: Basic Info --}}
    {{#if (eq stepName "basic-info")}}
    <div class="creator-step">
      <h3>Basic Information</h3>
      
      <div class="form-group">
        <label>Character Name</label>
        <input type="text" class="creator-input" data-field="name" value="{{character.name}}" placeholder="Enter character name" />
      </div>

      <div class="form-group">
        <label>Concept</label>
        <input type="text" class="creator-input" data-field="system.concept" value="{{character.system.concept}}" placeholder="e.g., Fire-wielding detective" />
      </div>

      <div class="form-group">
        <label>Player</label>
        <input type="text" class="creator-input" data-field="system.player" value="{{character.system.player}}" />
      </div>

      <div class="form-group">
        <label>Portrait</label>
        <div class="portrait-container">
          <img src="{{character.img}}" alt="Character portrait" />
          <button type="button" class="portrait-upload">
            <i class="fas fa-upload"></i> Upload Portrait
          </button>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- Step 2: Background --}}
    {{#if (eq stepName "background")}}
    <div class="creator-step">
      <h3>Background</h3>
      <p class="step-description">Choose a background for your character. Each background provides +1 to a specific attribute and informs your character's history.</p>

      {{#if selectedBackground}}
      <div class="selected-background">
        <h4>Selected: {{selectedBackground.name}}</h4>
        <p>{{selectedBackground.description}}</p>
        <p class="background-bonus">Bonus: +1 {{selectedBackground.attribute}}</p>
      </div>
      {{/if}}

      <div class="backgrounds-grid">
        {{#each backgrounds as |bg|}}
        <div class="background-option {{#if (eq bg.id ../character.system.background)}}selected{{/if}}" data-background="{{bg.id}}">
          <h4>{{bg.name}}</h4>
          <p>{{bg.description}}</p>
          <span class="background-bonus">+1 {{bg.attribute}}</span>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- Step 3: Core Stats --}}
    {{#if (eq stepName "core-stats")}}
    <div class="creator-step">
      <h3>Core Statistics</h3>
      <p class="step-description">Set your character's core stats. These determine your power level and resources.</p>

      <div class="stats-grid">
        <div class="stat-block">
          <label>Tier</label>
          <input type="number" class="creator-input" data-field="system.core.tier.value" value="{{character.system.core.tier.value}}" min="1" max="5" />
          <span class="stat-hint">Power level (1-5)</span>
        </div>

        <div class="stat-block">
          <label>Generation</label>
          <input type="number" class="creator-input" data-field="system.core.generation.value" value="{{character.system.core.generation.value}}" min="1" max="5" />
          <span class="stat-hint">Elysian age (1-5)</span>
        </div>

        <div class="stat-block">
          <label>Domain</label>
          <input type="number" class="creator-input" data-field="system.core.domain.value" value="{{character.system.core.domain.value}}" min="1" max="5" />
          <span class="stat-hint">Territory control (1-5)</span>
        </div>

        <div class="stat-block">
          <label>Size</label>
          <input type="number" class="creator-input" data-field="system.core.size.value" value="{{character.system.core.size.value}}" min="-2" max="2" />
          <span class="stat-hint">Physical size modifier (-2 to +2)</span>
        </div>

        <div class="stat-block">
          <label>XP</label>
          <input type="number" class="creator-input" data-field="system.core.xp.value" value="{{character.system.core.xp.value}}" min="0" />
          <span class="stat-hint">Starting experience points</span>
        </div>
      </div>
    </div>
    {{/if}}

    {{!-- Step 4: Attributes --}}
    {{#if (eq stepName "attributes")}}
    <div class="creator-step">
      <h3>Attributes</h3>
      <p class="step-description">Distribute 6 points among your attributes. Each starts at 1, maximum is 5. Your background has already provided +1 to one attribute.</p>
      
      <div class="attribute-points">
        <span class="points-label">Points Remaining:</span>
        <span class="points-value {{#if (eq attributePoints 0)}}complete{{else}}incomplete{{/if}}">{{attributePoints}}</span>
      </div>

      <div class="attributes-grid">
        {{#each character.system.attributes as |attr key|}}
        <div class="attribute-block">
          <label>{{key}}</label>
          <div class="attribute-controls">
            <button type="button" class="attribute-decrease" data-attribute="{{key}}" {{#if (lte attr.value 1)}}disabled{{/if}}>
              <i class="fas fa-minus"></i>
            </button>
            <span class="attribute-value">{{attr.value}}</span>
            <button type="button" class="attribute-increase" data-attribute="{{key}}" {{#if (gte attr.value 5)}}disabled{{/if}}>
              <i class="fas fa-plus"></i>
            </button>
          </div>
        </div>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- Step 5: Skills --}}
    {{#if (eq stepName "skills")}}
    <div class="creator-step">
      <h3>Skills</h3>
      <p class="step-description">Add skills that represent your character's training and expertise. You can add as many as you like.</p>

      <div class="skills-list">
        {{#each skillsList as |skill index|}}
        <div class="skill-entry">
          <div class="skill-fields">
            <input type="text" class="creator-input" data-field="skills.{{index}}.name" value="{{skill.name}}" placeholder="Skill name" />
            <select class="creator-input" data-field="skills.{{index}}.attribute">
              {{#select skill.attribute}}
              <option value="strength">Strength</option>
              <option value="dexterity">Dexterity</option>
              <option value="awareness">Awareness</option>
              <option value="composure">Composure</option>
              <option value="presence">Presence</option>
              <option value="intelligence">Intelligence</option>
              {{/select}}
            </select>
            <input type="number" class="creator-input" data-field="skills.{{index}}.bonus" value="{{skill.bonus}}" placeholder="Bonus" />
          </div>
          <button type="button" class="remove-skill" data-index="{{index}}">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{/each}}
      </div>

      <button type="button" class="add-skill">
        <i class="fas fa-plus"></i> Add Skill
      </button>
    </div>
    {{/if}}

    {{!-- Step 6: Powers --}}
    {{#if (eq stepName "powers")}}
    <div class="creator-step">
      <h3>Powers</h3>
      <p class="step-description">Add supernatural powers and abilities. These cost Gloriae to use.</p>

      <div class="powers-list">
        {{#each powersList as |power index|}}
        <div class="power-entry">
          <div class="power-fields">
            <input type="text" class="creator-input" data-field="powers.{{index}}.name" value="{{power.name}}" placeholder="Power name" />
            <select class="creator-input" data-field="powers.{{index}}.attribute">
              {{#select power.attribute}}
              <option value="strength">Strength</option>
              <option value="dexterity">Dexterity</option>
              <option value="awareness">Awareness</option>
              <option value="composure">Composure</option>
              <option value="presence">Presence</option>
              <option value="intelligence">Intelligence</option>
              {{/select}}
            </select>
            <input type="number" class="creator-input" data-field="powers.{{index}}.apCost" value="{{power.apCost}}" placeholder="AP" />
            <input type="number" class="creator-input" data-field="powers.{{index}}.glorieaCost" value="{{power.glorieaCost}}" placeholder="Gloriae" />
          </div>
          <textarea class="creator-input" data-field="powers.{{index}}.description" placeholder="Description">{{power.description}}</textarea>
          <button type="button" class="remove-power" data-index="{{index}}">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{/each}}
      </div>

      <button type="button" class="add-power">
        <i class="fas fa-plus"></i> Add Power
      </button>
    </div>
    {{/if}}

    {{!-- Step 7: Equipment --}}
    {{#if (eq stepName "equipment")}}
    <div class="creator-step">
      <h3>Equipment</h3>
      <p class="step-description">Add starting equipment, weapons, and armor.</p>

      <div class="equipment-list">
        {{#each equipmentList as |item index|}}
        <div class="equipment-entry">
          <div class="equipment-fields">
            <input type="text" class="creator-input" data-field="equipment.{{index}}.name" value="{{item.name}}" placeholder="Item name" />
            <select class="creator-input" data-field="equipment.{{index}}.equipmentType">
              {{#select item.equipmentType}}
              <option value="weapon">Weapon</option>
              <option value="armor">Armor</option>
              <option value="gear">Gear</option>
              {{/select}}
            </select>
            <input type="text" class="creator-input" data-field="equipment.{{index}}.bonus" value="{{item.bonus}}" placeholder="Bonus" />
          </div>
          <button type="button" class="remove-equipment" data-index="{{index}}">
            <i class="fas fa-trash"></i>
          </button>
        </div>
        {{/each}}
      </div>

      <button type="button" class="add-equipment">
        <i class="fas fa-plus"></i> Add Equipment
      </button>
    </div>
    {{/if}}

    {{!-- Step 8: Review --}}
    {{#if (eq stepName "review")}}
    <div class="creator-step">
      <h3>Review Character</h3>
      <p class="step-description">Review your character before creating it. You can go back to make changes.</p>

      <div class="review-section">
        <h4>Basic Information</h4>
        <div class="review-item">
          <span class="review-label">Name:</span>
          <span class="review-value">{{character.name}}</span>
        </div>
        <div class="review-item">
          <span class="review-label">Concept:</span>
          <span class="review-value">{{character.system.concept}}</span>
        </div>
        {{#if selectedBackground}}
        <div class="review-item">
          <span class="review-label">Background:</span>
          <span class="review-value">{{selectedBackground.name}}</span>
        </div>
        {{/if}}
      </div>

      <div class="review-section">
        <h4>Core Statistics</h4>
        <div class="review-grid">
          <div class="review-item">
            <span class="review-label">Tier:</span>
            <span class="review-value">{{character.system.core.tier.value}}</span>
          </div>
          <div class="review-item">
            <span class="review-label">Generation:</span>
            <span class="review-value">{{character.system.core.generation.value}}</span>
          </div>
          <div class="review-item">
            <span class="review-label">Domain:</span>
            <span class="review-value">{{character.system.core.domain.value}}</span>
          </div>
          <div class="review-item">
            <span class="review-label">Size:</span>
            <span class="review-value">{{character.system.core.size.value}}</span>
          </div>
        </div>
      </div>

      <div class="review-section">
        <h4>Attributes</h4>
        <div class="review-grid">
          {{#each character.system.attributes as |attr key|}}
          <div class="review-item">
            <span class="review-label">{{key}}:</span>
            <span class="review-value">{{attr.value}}</span>
          </div>
          {{/each}}
        </div>
      </div>

      {{#if skillsList.length}}
      <div class="review-section">
        <h4>Skills ({{skillsList.length}})</h4>
        <ul class="review-list">
          {{#each skillsList as |skill|}}
          <li>{{skill.name}} ({{skill.attribute}}{{#if skill.bonus}} +{{skill.bonus}}{{/if}})</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      {{#if powersList.length}}
      <div class="review-section">
        <h4>Powers ({{powersList.length}})</h4>
        <ul class="review-list">
          {{#each powersList as |power|}}
          <li>{{power.name}} ({{power.apCost}} AP, {{power.glorieaCost}} Gloriae)</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}

      {{#if equipmentList.length}}
      <div class="review-section">
        <h4>Equipment ({{equipmentList.length}})</h4>
        <ul class="review-list">
          {{#each equipmentList as |item|}}
          <li>{{item.name}} ({{item.equipmentType}})</li>
          {{/each}}
        </ul>
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>

  <div class="creator-footer">
    <button type="button" class="creator-cancel">
      <i class="fas fa-times"></i> Cancel
    </button>
    <div class="creator-navigation">
      {{#unless isFirstStep}}
      <button type="button" class="creator-prev">
        <i class="fas fa-arrow-left"></i> Previous
      </button>
      {{/unless}}
      
      {{#if isLastStep}}
      <button type="button" class="creator-finish">
        <i class="fas fa-check"></i> Create Character
      </button>
      {{else}}
      <button type="button" class="creator-next">
        Next <i class="fas fa-arrow-right"></i>
      </button>
      {{/if}}
    </div>
  </div>
</form>
