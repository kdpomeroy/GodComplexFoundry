<form class="{{cssClass}} godcomplex sheet actor" autocomplete="off">
  {{!-- Sheet Header --}}
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <h1 class="charname">
        <input name="name" type="text" value="{{actor.name}}" placeholder="{{localize 'CharacterName'}}" />
      </h1>
      <div class="header-row">
        <div class="header-field">
          <label>{{localize "Concept"}}</label>
          <input type="text" name="system.concept" value="{{system.concept}}" />
        </div>
        <div class="header-field">
          <label>{{localize "Player"}}</label>
          <input type="text" name="system.player" value="{{system.player}}" />
        </div>
      </div>
    </div>
  </header>

  {{!-- Sheet Tab Navigation --}}
  <nav class="sheet-tabs tabs" data-group="primary">
    <a class="item" data-tab="attributes">{{localize "Attributes"}}</a>
    <a class="item" data-tab="skills">{{localize "Skills"}}</a>
    <a class="item" data-tab="powers">{{localize "Powers"}}</a>
    <a class="item" data-tab="equipment">{{localize "Equipment"}}</a>
    <a class="item" data-tab="biography">{{localize "Biography"}}</a>
  </nav>

  {{!-- Sheet Body --}}
  <section class="sheet-body">
    {{!-- Attributes Tab --}}
    <div class="tab attributes" data-group="primary" data-tab="attributes">
      {{!-- Core Stats --}}
      <div class="panel core-stats">
        <h2>{{localize "CoreStats"}}</h2>
        <div class="stats-grid">
          <div class="stat-block">
            <label>{{localize "Tier"}}</label>
            <input type="number" name="system.core.tier.value" value="{{system.core.tier.value}}" min="{{system.core.tier.min}}" max="{{system.core.tier.max}}" />
          </div>
          <div class="stat-block">
            <label>{{localize "Generation"}}</label>
            <input type="number" name="system.core.generation.value" value="{{system.core.generation.value}}" min="{{system.core.generation.min}}" max="{{system.core.generation.max}}" />
          </div>
          <div class="stat-block">
            <label>{{localize "Domain"}}</label>
            <input type="number" name="system.core.domain.value" value="{{system.core.domain.value}}" min="{{system.core.domain.min}}" max="{{system.core.domain.max}}" />
          </div>
          <div class="stat-block">
            <label>{{localize "Size"}}</label>
            <input type="number" name="system.core.size.value" value="{{system.core.size.value}}" min="{{system.core.size.min}}" max="{{system.core.size.max}}" />
          </div>
          <div class="stat-block">
            <label>{{localize "XP"}}</label>
            <input type="number" name="system.core.xp.value" value="{{system.core.xp.value}}" />
          </div>
        </div>
      </div>

      {{!-- Attributes --}}
      <div class="panel attributes-panel">
        <h2>{{localize "Attributes"}}</h2>
        <div class="attributes-grid">
          {{#each attributes as |attr key|}}
          <div class="attribute-block">
            <label>{{capitalize key}}</label>
            <input type="number" name="system.attributes.{{key}}.value" value="{{attr.value}}" min="{{attr.min}}" max="{{attr.max}}" />
            <button type="button" class="attribute-roll" data-attribute="{{key}}" title="Roll {{capitalize key}}">
              <i class="fas fa-dice"></i>
            </button>
          </div>
          {{/each}}
        </div>
      </div>

      {{!-- Characteristics --}}
      <div class="panel derived-stats">
        <h2>{{localize "Characteristics"}}</h2>
        <div class="stats-grid">
          <div class="stat-block">
            <label>{{localize "Fortitude"}}</label>
            <span class="stat-value">{{system.derived.fortitude.value}}</span>
          </div>
          <div class="stat-block">
            <label>{{localize "Evasion"}}</label>
            <span class="stat-value">{{system.derived.evasion.value}}</span>
          </div>
          <div class="stat-block">
            <label>{{localize "Conviction"}}</label>
            <span class="stat-value">{{system.derived.conviction.value}}</span>
          </div>
          <div class="stat-block">
            <label>{{localize "Willpower"}}</label>
            <span class="stat-value">{{system.derived.willpower.value}}</span>
          </div>
          <div class="stat-block">
            <label>{{localize "Initiative"}}</label>
            <span class="stat-value">{{system.derived.initiative.value}}</span>
            <button type="button" class="derived-roll" data-stat="initiative" title="{{localize 'RollInitiative'}}">
              <i class="fas fa-dice"></i>
            </button>
          </div>
          <div class="stat-block">
            <label>{{localize "Speed"}}</label>
            <span class="stat-value">{{system.derived.speed.value}} ft</span>
          </div>
        </div>
      </div>

      {{!-- Resources --}}
      <div class="panel resources-panel">
        <h2>{{localize "Resources"}}</h2>
        <div class="resources-grid">
          <div class="resource-block">
            <label>{{localize "Health"}}</label>
            <div class="resource-input">
              <input type="number" class="resource-value" data-resource="health" value="{{system.resources.health.value}}" />
              <span>/</span>
              <span class="resource-max">{{system.resources.health.max}}</span>
            </div>
          </div>
          <div class="resource-block">
            <label>{{localize "Gloriae"}}</label>
            <div class="resource-input">
              <input type="number" class="resource-value" data-resource="gloriea" value="{{system.resources.gloriea.value}}" />
              <span>/</span>
              <span class="resource-max">{{system.resources.gloriea.max}}</span>
            </div>
          </div>
          <div class="resource-block">
            <label>{{localize "Willpower"}}</label>
            <div class="resource-input">
              <input type="number" class="resource-value" data-resource="willpower" value="{{system.resources.willpower.value}}" />
              <span>/</span>
              <span class="resource-max">{{system.resources.willpower.max}}</span>
            </div>
          </div>
          <div class="resource-block">
            <label>{{localize "AP"}}</label>
            <div class="resource-input">
              <input type="number" class="resource-value" data-resource="ap" value="{{system.resources.ap.value}}" />
              <span>/</span>
              <span class="resource-max">{{system.resources.ap.max}}</span>
            </div>
          </div>
        </div>
        <div class="rest-buttons">
          <button type="button" class="rest-button" data-rest-type="short">{{localize "ShortRest"}}</button>
          <button type="button" class="rest-button" data-rest-type="long">{{localize "LongRest"}}</button>
        </div>
      </div>

      {{!-- Conditions --}}
      <div class="panel conditions-panel">
        <h2>{{localize "Conditions"}}</h2>
        <div class="conditions-grid">
          {{#each conditions as |active key|}}
          <label class="condition-toggle {{#if active}}active{{/if}}" data-condition="{{key}}">
            <input type="checkbox" name="system.conditions.{{key}}" {{#if active}}checked{{/if}} />
            <span>{{localize (concat "Conditions." key)}}</span>
          </label>
          {{/each}}
        </div>
      </div>
    </div>

    {{!-- Skills Tab --}}
    <div class="tab skills" data-group="primary" data-tab="skills">
      <div class="panel">
        <h2>{{localize "Skills"}}</h2>
        <ol class="item-list">
          {{#each skills as |skill id|}}
          <li class="item" data-item-id="{{skill._id}}">
            <div class="item-header">
              <button type="button" class="skill-roll" data-item-id="{{skill._id}}">
                <i class="fas fa-dice"></i>
              </button>
              <input type="text" class="inline-edit" data-field="name" value="{{skill.name}}" />
            </div>
            <div class="item-details">
              <select class="inline-edit" data-field="system.attribute">
                {{#select skill.system.attribute}}
                <option value="strength">{{localize "Attributes.strength"}}</option>
                <option value="dexterity">{{localize "Attributes.dexterity"}}</option>
                <option value="awareness">{{localize "Attributes.awareness"}}</option>
                <option value="composure">{{localize "Attributes.composure"}}</option>
                <option value="presence">{{localize "Attributes.presence"}}</option>
                <option value="intelligence">{{localize "Attributes.intelligence"}}</option>
                {{/select}}
              </select>
              <input type="number" class="inline-edit" data-field="system.bonus" value="{{skill.system.bonus}}" />
            </div>
            <div class="item-controls">
              <a class="item-edit" data-item-id="{{skill._id}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-item-id="{{skill._id}}"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
        <button type="button" class="item-create" data-type="skill">
          <i class="fas fa-plus"></i> {{localize "AddSkill"}}
        </button>
      </div>
    </div>

    {{!-- Powers Tab --}}
    <div class="tab powers" data-group="primary" data-tab="powers">
      <div class="panel">
        <h2>{{localize "Powers"}}</h2>
        <ol class="item-list">
          {{#each powers as |power id|}}
          <li class="item" data-item-id="{{power._id}}">
            <div class="item-header">
              <button type="button" class="power-roll" data-item-id="{{power._id}}">
                <i class="fas fa-dice"></i>
              </button>
              <input type="text" class="inline-edit" data-field="name" value="{{power.name}}" />
            </div>
            <div class="item-details">
              <span class="item-cost">{{power.system.apCost}} AP</span>
              <span class="item-cost">{{power.system.glorieaCost}} Gloriae</span>
            </div>
            <div class="item-controls">
              <a class="item-edit" data-item-id="{{power._id}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-item-id="{{power._id}}"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
        <button type="button" class="item-create" data-type="power">
          <i class="fas fa-plus"></i> {{localize "AddPower"}}
        </button>
      </div>
    </div>

    {{!-- Equipment Tab --}}
    <div class="tab equipment" data-group="primary" data-tab="equipment">
      <div class="panel">
        <h2>{{localize "Equipment"}}</h2>
        <ol class="item-list">
          {{#each equipment as |item id|}}
          <li class="item" data-item-id="{{item._id}}">
            <div class="item-header">
              <a class="item-toggle" data-item-id="{{item._id}}">
                <i class="fas {{#if item.system.equipped}}fa-check-circle{{else}}fa-circle{{/if}}"></i>
              </a>
              <input type="text" class="inline-edit" data-field="name" value="{{item.name}}" />
            </div>
            <div class="item-details">
              <span class="item-type">{{item.system.equipmentType}}</span>
              {{#if item.system.armor}}<span class="item-stat">Armor: {{item.system.armor}}</span>{{/if}}
              {{#if item.system.damage}}<span class="item-stat">Damage: {{item.system.damage}}</span>{{/if}}
            </div>
            <div class="item-controls">
              <a class="item-edit" data-item-id="{{item._id}}"><i class="fas fa-edit"></i></a>
              <a class="item-delete" data-item-id="{{item._id}}"><i class="fas fa-trash"></i></a>
            </div>
          </li>
          {{/each}}
        </ol>
        <button type="button" class="item-create" data-type="equipment">
          <i class="fas fa-plus"></i> {{localize "AddEquipment"}}
        </button>
      </div>
    </div>

    {{!-- Biography Tab --}}
    <div class="tab biography" data-group="primary" data-tab="biography">
      <div class="panel">
        <h2>{{localize "Biography"}}</h2>
        {{editor biography target="system.biography" button=true owner=owner editable=editable}}
      </div>
      <div class="panel">
        <h2>{{localize "Notes"}}</h2>
        <textarea name="system.notes">{{system.notes}}</textarea>
      </div>
    </div>
  </section>
</form>
